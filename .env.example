# Documentation only. Set production values with the hosting provider's secret mechanism.
# The local pnpm preview does not load this file or contact external providers.
PUBLIC_ORIGIN=https://your-assessment-origin.example
RATE_LIMIT_SALT=
# Optional dedicated Jina free-credit key. Leave blank for anonymous retrieval.
# Configure as a secret in Sites; never in browser code. No paid top-ups.
# Token accounting verifies a free-only wallet and reserves at most 8M tokens.
# Requests reserve 20k tokens; reported usage settles unused reservations.
# Without token accounting, the legacy non-renewing cap is 400 attempts.
# Use a new key with its free allowance; usage elsewhere also consumes its balance.
JINA_FREE_API_KEY=
JINA_TOKEN_ACCOUNTING=1

# Optional Tavily Researcher/free account key. Pay-as-you-go must be disabled.
# The live usage endpoint must confirm the free plan before EVERY request.
# Dedicated key; server secret only. At most 400 non-renewing reserved credits,
# two per attempt (including errors). No paid plan, top-up or automatic renewal.
TAVILY_FREE_API_KEY=
